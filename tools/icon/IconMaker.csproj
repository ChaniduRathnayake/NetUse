<Project Sdk="Microsoft.NET.Sdk">
  <!-- Draws NetUse's icon. From the repo root run:   dotnet run (project tools/icon, then the output folder: .)
       See the "Project layout" table in README.md for the exact command.
       It writes app.ico (16 to 256 px, each size drawn separately), app.png (256 px) and preview.png. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
</Project>
