<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET 10 LTS (supported to Nov 2028). .NET 8 support ended 10 Nov 2026: the runtime is bundled, so only
         rebuilding NetUse patches it. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- Program.Main: "Start with Windows" runs NetUse as SYSTEM to launch it in your session, without loading WPF -->
    <StartupObject>NetUse.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NetUse</AssemblyName>
    <RootNamespace>NetUse</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.4.0</Version>
    <Product>NetUse</Product>
    <Company>NetUse</Company>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- WFAC010 is a WinForms analyzer; this is a WPF app (WinForms is only used for the tray icon), which reads DPI awareness from app.manifest -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
    <Copyright>Copyright © 2026 NetUse</Copyright>
    <!-- runs elevated: don't let DOTNET_STARTUP_HOOKS from the user's environment load code into it -->
    <StartupHookSupport>false</StartupHookSupport>
    <!-- a package with a known moderate/high/critical vulnerability (direct or transitive) fails the build -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>

  <!-- `dotnet publish -c Release` => a self-contained NetUse.exe (no .NET install needed) plus its native DLLs -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SECURITY: native DLLs are NOT self-extracted. Self-extraction unpacks them to %TEMP%\.net, which the
         non-elevated user (and any program they run) can write to, and the elevated NetUse would then load a
         swapped DLL as administrator - silently at every logon via "Start with Windows". The six native DLLs
         ship next to NetUse.exe instead (Program Files for the installer, the same folder for portable). -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <DebugType>embedded</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- app icon (128px frame of app.ico) shown as the logo in the title bar and About -->
    <Resource Include="app.png" />
    <!-- country flags for destinations (public domain, flagcdn.com) -->
    <Resource Include="Resources\Flags\*.png" />
    <!-- offline IP-to-country table (CC0, sapics/ip-location-db); rebuild with tools\make-geoip.py -->
    <EmbeddedResource Include="Resources\geoip.bin" LogicalName="NetUse.geoip.bin" />
    <!-- build date shown in About -->
    <AssemblyMetadata Include="BuildDate" Value="$([System.DateTime]::Now.ToString('yyyy-MM-dd HH:mm'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.1.16" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <!-- the SQLite library itself: 2.1.12+ has the fix for CVE-2025-6965 (memory corruption, GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <!-- TraceEvent copies helpers for ETL merging and PDB symbols (amd64\KernelTraceControl.dll, msdia140.dll,
       TraceReloggerLib.dll, Dia2Lib.dll). A live kernel session on Windows 10/11 doesn't use them, so they're
       left out instead of sitting loose next to the exe. -->
  <Target Name="DropTraceEventExtras" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <None Remove="@(None)" Condition="$([System.String]::Copy('%(None.FullPath)').ToLowerInvariant().Contains('microsoft.diagnostics.tracing.traceevent'))" />
    </ItemGroup>
  </Target>
</Project>
