<Window x:Class="NetUse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:NetUse"
        Title="NetUse" Width="1280" Height="820" MinWidth="1080" MinHeight="660"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextPrimary}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- usage breakdown item -->
    <DataTemplate x:Key="UsageItemTpl">
      <Grid Margin="8,7" ToolTip="{Binding Tip}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
          <Image Source="{Binding Icon}" Width="18" Height="18"/>
          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="sub" Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Amount}" Style="{StaticResource Num}" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" Margin="10,0,0,0"/>
        <local:SplitBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" In="{Binding InFrac}" Out="{Binding OutFrac}" Height="3" Margin="0,6,0,0"/>
      </Grid>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Sub}" Value=""><Setter TargetName="sub" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="ExpandBtn" TargetType="ToggleButton">
      <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="b" Width="30" Height="30" CornerRadius="8" Background="Transparent">
              <TextBlock x:Name="g" Text="&#xE70D;" Style="{StaticResource Glyph}" FontSize="11" HorizontalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="g" Property="Text" Value="&#xE70E;"/>
                <Setter Property="Foreground" Value="{DynamicResource Primary}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- firewall app row -->
    <DataTemplate x:Key="FwRowTpl">
      <Border x:Name="row" CornerRadius="8" Padding="6,8" Background="Transparent">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="56"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/>
              <ColumnDefinition Width="104"/><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="36"/>
            </Grid.ColumnDefinitions>
            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding IsAllowed, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                      Click="FwToggle_Click" VerticalAlignment="Center" ToolTip="On = allowed, off = blocked"
                      AutomationProperties.Name="{Binding Name, StringFormat='Allow {0}'}"/>
            <Image Grid.Column="1" Source="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <ContentControl x:Name="newBadge" Style="{StaticResource Badge}" Tag="warn" Content="New" Margin="8,0,0,0" Visibility="Collapsed"/>
              </StackPanel>
              <TextBlock Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding Publisher, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Exe, Mode=OneWay}"/>
              </TextBlock>
            </StackPanel>
            <TextBlock Grid.Column="3" Text="{Binding In}" Style="{StaticResource Num}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="4" Text="{Binding Out}" Style="{StaticResource Num}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="5" Text="{Binding Hosts}" Style="{StaticResource Num}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="6" Text="{Binding Last}" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            <ContentControl Grid.Column="7" Style="{StaticResource Badge}" Tag="{Binding ActKind}" Content="{Binding Activity}"
                            HorizontalAlignment="Left" VerticalAlignment="Center"/>
            <ToggleButton x:Name="exp" Grid.Column="8" Style="{StaticResource ExpandBtn}" IsChecked="{Binding Expanded, Mode=OneWay}"
                          Click="FwExpand_Click" ToolTip="Connection details" AutomationProperties.Name="Connection details"/>
          </Grid>
          <Border Margin="94,8,8,2" Padding="12,10" CornerRadius="8" Background="{DynamicResource Surface2}"
                  Visibility="{Binding IsChecked, ElementName=exp, Converter={StaticResource B2V}}">
            <TextBlock Text="{Binding Details}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                       Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
          </Border>
        </StackPanel>
      </Border>
      <DataTemplate.Triggers>
        <Trigger SourceName="row" Property="IsMouseOver" Value="True"><Setter TargetName="row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
        <DataTrigger Binding="{Binding IsNew}" Value="True"><Setter TargetName="newBadge" Property="Visibility" Value="Visible"/></DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Root">
    <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <!-- ===================== Top bar (title bar + navigation) ===================== -->
    <Border Background="{DynamicResource TopBar}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" Margin="18,0,12,0" VerticalAlignment="Center">
          <Image Source="/app.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"/>
          <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="NetUse" FontSize="15" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
              <Ellipse x:Name="StatusDot" Style="{StaticResource Dot}" Width="6" Height="6" Tag="ok" Margin="0,0,5,0"/>
              <TextBlock x:Name="StatusText" Text="Monitoring" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
          <RadioButton x:Name="NavOverview" Style="{StaticResource TopNav}" local:Ui.Glyph="&#xE80F;" Content="Overview" Tag="Overview" IsChecked="True" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource TopNav}" local:Ui.Glyph="&#xE9D2;" Content="Graph" Tag="Graph" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource TopNav}" local:Ui.Glyph="&#xEB05;" Content="Usage" Tag="Usage" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource TopNav}" local:Ui.Glyph="&#xEA18;" Content="Firewall" Tag="Firewall" Checked="Nav_Checked"/>
          <RadioButton Style="{StaticResource TopNav}" local:Ui.Glyph="&#xE839;" Content="Network" Tag="Network" Checked="Nav_Checked"/>
          <Grid>
            <RadioButton x:Name="NavAlerts" Style="{StaticResource TopNav}" local:Ui.Glyph="&#xEA8F;" Content="Alerts" Tag="Alerts" Checked="Nav_Checked"/>
            <Border x:Name="AlertsBadge" Background="{DynamicResource Danger}" CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                    HorizontalAlignment="Center" VerticalAlignment="Top" Margin="22,8,0,0" IsHitTestVisible="False" Visibility="Collapsed">
              <TextBlock x:Name="AlertsBadgeText" FontSize="10" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <RadioButton Style="{StaticResource TopNav}" local:Ui.Glyph="&#xE7F4;" Content="System" Tag="System" Checked="Nav_Checked"/>
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <Button x:Name="PausedPill" Style="{StaticResource Pill}" Margin="0,0,8,0" Visibility="Collapsed" Click="Pause_Click"
                  ToolTip="Monitoring is paused - click to resume">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE768;" Style="{StaticResource Glyph}" FontSize="11" Margin="0,0,6,0"/>
              <TextBlock Text="Paused · Resume"/>
            </StackPanel>
          </Button>
          <Button x:Name="PauseBtn" Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE769;" Click="Pause_Click"
                  ToolTip="Pause monitoring" AutomationProperties.Name="Pause monitoring"/>
          <Button Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE8A7;" Click="Mini_Click" Margin="2,0"
                  ToolTip="Mini graph" AutomationProperties.Name="Show mini graph"/>
          <RadioButton x:Name="NavSettings" Style="{StaticResource IconNav}" local:Ui.Glyph="&#xE713;" Tag="Settings" Checked="Nav_Checked"
                       ToolTip="Settings" AutomationProperties.Name="Settings"/>
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
          <Button Style="{StaticResource CaptionBtn}" local:Ui.Glyph="&#xE921;" Click="Min_Click" AutomationProperties.Name="Minimize"/>
          <Button x:Name="MaxBtn" Style="{StaticResource CaptionBtn}" local:Ui.Glyph="&#xE922;" Click="Max_Click" AutomationProperties.Name="Maximize"/>
          <Button Style="{StaticResource CaptionClose}" local:Ui.Glyph="&#xE8BB;" Click="Close_Click" AutomationProperties.Name="Close"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== Pages ===================== -->
    <Grid Grid.Row="1" x:Name="PageHost" Margin="24,20,24,20">

      <!-- ============ Overview ============ -->
      <ScrollViewer x:Name="PageOverview" Tag="Overview" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,6,0">
          <local:PageHeader Title="Overview" Subtitle="Live network activity on this PC"/>

          <UniformGrid Columns="4" Margin="0,0,0,14">
            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
              <StackPanel>
                <TextBlock Text="RIGHT NOW" Style="{StaticResource Cap}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Incoming}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiNowDown" Style="{StaticResource Metric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Outgoing}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiNowUp" Style="{StaticResource Metric}" FontSize="18"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="7,0">
              <StackPanel>
                <TextBlock Text="TODAY" Style="{StaticResource Cap}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Incoming}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiTodayDown" Style="{StaticResource Metric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Outgoing}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiTodayUp" Style="{StaticResource Metric}" FontSize="18"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="7,0">
              <StackPanel>
                <TextBlock Text="THIS MONTH" Style="{StaticResource Cap}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Incoming}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiMonthDown" Style="{StaticResource Metric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Outgoing}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiMonthUp" Style="{StaticResource Metric}" FontSize="18"/>
                </StackPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="7,0,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="ALL TIME" Style="{StaticResource Cap}"/>
                  <TextBlock x:Name="KpiAllSince" Style="{StaticResource Cap}" FontWeight="Normal" Margin="6,0,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Incoming}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiAllDown" Style="{StaticResource Metric}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock Text="&#xE898;" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource Outgoing}" Margin="0,4,8,0"/>
                  <local:MetricText x:Name="KpiAllUp" Style="{StaticResource Metric}" FontSize="18"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </UniformGrid>

          <Border x:Name="PlanPanel" Style="{StaticResource Panel}" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock x:Name="PlanText" Style="{StaticResource H2}"/>
                <ProgressBar x:Name="PlanBar" Minimum="0" Maximum="100" Margin="0,10,0,0" AutomationProperties.Name="Data plan used"/>
              </StackPanel>
              <TextBlock x:Name="PlanSub" Grid.Column="1" Style="{StaticResource Muted}" VerticalAlignment="Top" Margin="16,2,0,0"/>
            </Grid>
          </Border>

          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="8,14,8,8" Margin="0,0,14,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="230"/></Grid.RowDefinitions>
                <Grid Margin="10,0,6,6">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Live traffic" Style="{StaticResource H2}" Margin="0,0,16,0"/>
                    <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Incoming}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Incoming" Style="{StaticResource Muted}" Margin="0,0,14,0" VerticalAlignment="Center"/>
                    <Rectangle Width="10" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="{DynamicResource Outgoing}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Outgoing" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Content="Open graph" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="OpenGraph_Click"/>
                </Grid>
                <local:TrafficChart x:Name="LiveChart" Grid.Row="1" EmptyText="Waiting for network activity…"
                                    AutomationProperties.Name="Live traffic chart, last two minutes"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Panel}">
              <StackPanel>
                <TextBlock Text="Protection" Style="{StaticResource H2}" Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                    <TextBlock Text="Windows Firewall" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ContentControl x:Name="SecFirewall" Style="{StaticResource Badge}" Tag="off" Content="Checking…" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72E;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                    <TextBlock Text="Blocked apps" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="SecBlocked" Text="0" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xEA8F;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                    <TextBlock Text="Unread alerts" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="SecAlerts" Text="0" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE772;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                    <TextBlock Text="Devices on network" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="SecDevices" Text="—" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
                </Grid>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE701;" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                    <TextBlock Text="Wi-Fi" VerticalAlignment="Center"/>
                  </StackPanel>
                  <TextBlock x:Name="SecWifi" Text="Not connected" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"
                             MaxWidth="170" TextTrimming="CharacterEllipsis"/>
                </Grid>
              </StackPanel>
            </Border>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource Panel}" Padding="8,14,8,8" Margin="0,0,14,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Active apps" Style="{StaticResource H2}" Margin="10,0,0,6"/>
                <DataGrid x:Name="TopGrid" Grid.Row="1" MaxHeight="360" CanUserSortColumns="False" AutomationProperties.Name="Apps using the network now">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Header="App" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal">
                            <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Incoming" Binding="{Binding Download}" Width="120"/>
                    <DataGridTextColumn Header="Outgoing" Binding="{Binding Upload}" Width="120"/>
                  </DataGrid.Columns>
                </DataGrid>
                <local:EmptyState x:Name="TopEmpty" Grid.Row="1" Glyph="&#xE774;" Title="No apps are using the network"
                                  Text="Apps appear here the moment they send or receive data."/>
              </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Panel}" Padding="16,14">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <TextBlock Text="Recent activity" Style="{StaticResource H2}" VerticalAlignment="Center"/>
                  <Button Content="View all" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="FeedViewAll_Click"/>
                </Grid>
                <ItemsControl x:Name="FeedList" Focusable="False">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="0,0,0,12" ToolTip="{Binding FullTime}">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="dot" Style="{StaticResource Dot}" Tag="{Binding Kind}" Margin="0,0,10,0"/>
                        <Grid Grid.Column="1" Width="24" Height="24">
                          <Border CornerRadius="7" Background="{DynamicResource Surface2}" Visibility="{Binding Glyph, Converter={StaticResource NonEmpty}}">
                            <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                          </Border>
                          <Image Source="{Binding Icon}" Width="22" Height="22"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Margin="10,0,8,0">
                          <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Sub}" Style="{StaticResource Muted}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="3" Text="{Binding Time}" Style="{StaticResource Muted}" FontSize="11.5" VerticalAlignment="Center"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <local:EmptyState x:Name="FeedEmpty" Glyph="&#xEA8F;" Title="All quiet" Text="Security events and alerts will show up here."/>
              </StackPanel>
            </Border>
          </Grid>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Graph (network time machine) ============ -->
      <Grid x:Name="PageGraph" Tag="Graph" Visibility="Collapsed">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <local:PageHeader x:Name="GraphHeader" Title="Traffic graph" Subtitle="">
          <Border x:Name="LiveBadge" Style="{StaticResource SegBox}" Padding="12,6">
            <StackPanel Orientation="Horizontal">
              <Ellipse Width="8" Height="8" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,8,0">
                <Ellipse.Triggers>
                  <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                      <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:1"/>
                      </Storyboard>
                    </BeginStoryboard>
                  </EventTrigger>
                </Ellipse.Triggers>
              </Ellipse>
              <TextBlock Text="LIVE" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="GraphClock" Style="{StaticResource Num}" FontSize="12" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </local:PageHeader>

        <Grid Grid.Row="1" Margin="0,0,0,8">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <WrapPanel VerticalAlignment="Center">
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="5 minutes" Tag="live" IsChecked="True" Checked="TlPeriod_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="1 hour" Tag="h1" Checked="TlPeriod_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="24 hours" Tag="h24" Checked="TlPeriod_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="7 days" Tag="d7" Checked="TlPeriod_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="30 days" Tag="d30" Checked="TlPeriod_Checked"/>
            <RadioButton Style="{StaticResource Chip}" GroupName="TlP" Content="Custom range" Tag="custom" Checked="TlPeriod_Checked"/>
            <StackPanel x:Name="TlCustom" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,6">
              <DatePicker x:Name="TlFrom" SelectedDateChanged="Date_Changed" AutomationProperties.Name="From date"/>
              <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}"/>
              <DatePicker x:Name="TlTo" SelectedDateChanged="Date_Changed" AutomationProperties.Name="To date"/>
            </StackPanel>
          </WrapPanel>
          <Border x:Name="ZoomGroup" Grid.Column="1" Style="{StaticResource SegBox}" VerticalAlignment="Top" Padding="2">
            <StackPanel Orientation="Horizontal">
              <Button Style="{StaticResource SegBtn}" local:Ui.Glyph="&#xE76B;" Click="PanLeft_Click" ToolTip="Earlier" AutomationProperties.Name="Pan earlier"/>
              <Button Style="{StaticResource SegBtn}" local:Ui.Glyph="&#xE71F;" Click="ZoomOut_Click" ToolTip="Zoom out" AutomationProperties.Name="Zoom out"/>
              <Button Style="{StaticResource SegBtn}" local:Ui.Glyph="&#xE8A3;" Click="ZoomIn_Click" ToolTip="Zoom in" AutomationProperties.Name="Zoom in"/>
              <Button Style="{StaticResource SegBtn}" local:Ui.Glyph="&#xE76C;" Click="PanRight_Click" ToolTip="Later" AutomationProperties.Name="Pan later"/>
              <Rectangle Width="1" Margin="3,6" Fill="{DynamicResource BorderStrong}"/>
              <Button Style="{StaticResource SegBtn}" local:Ui.Glyph="&#xE9A6;" Click="ZoomReset_Click" ToolTip="Show whole period" AutomationProperties.Name="Reset zoom"/>
            </StackPanel>
          </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="6,10,6,6">
          <Grid>
            <local:TrafficChart x:Name="GraphChart" ShowEventLane="True" EmptyText="No traffic recorded in this period yet."
                                AutomationProperties.Name="Traffic graph with security events"/>
            <Border x:Name="DetailPanel" Style="{StaticResource Raised}" Width="320" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,12,0" Visibility="Collapsed">
              <StackPanel>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <Image x:Name="DetIcon" Width="34" Height="34" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="DetTitle" FontSize="14.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                      <ContentControl x:Name="DetBadge" Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,4,0,0"/>
                    </StackPanel>
                  </StackPanel>
                  <Button Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE711;" FontSize="11" Width="28" Height="28"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Click="DetClose_Click" ToolTip="Close" AutomationProperties.Name="Close details"/>
                </Grid>
                <StackPanel x:Name="DetFields" Margin="0,14,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,12,0,0" Padding="20,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Right" Width="120">
                <local:MetricText x:Name="GraphIn" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="GraphInRate" Style="{StaticResource Muted}" HorizontalAlignment="Right"/>
              </StackPanel>
              <Grid Grid.Column="1" Width="96" Height="96" Margin="18,0">
                <local:Donut x:Name="GraphDonut" Thickness="8"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="TOTAL" Style="{StaticResource Cap}" FontSize="9.5" HorizontalAlignment="Center"/>
                  <TextBlock x:Name="GraphTotal" Style="{StaticResource Num}" FontWeight="SemiBold" FontSize="13.5" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Width="120">
                <local:MetricText x:Name="GraphOut" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock x:Name="GraphOutRate" Style="{StaticResource Muted}"/>
              </StackPanel>
              <Border Grid.Column="3" Width="1" Background="{DynamicResource Border}" Margin="24,4"/>
              <Grid Grid.Column="4" VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="WAN" Style="{StaticResource Cap}" VerticalAlignment="Center" ToolTip="Internet traffic"/>
                <TextBlock x:Name="WanText" Grid.Column="1" Style="{StaticResource Num}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <local:SplitBar x:Name="WanBar" Grid.Column="2" Height="5" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="1" Text="LAN" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,10,0,0" ToolTip="Local network traffic"/>
                <TextBlock x:Name="LanText" Grid.Row="1" Grid.Column="1" Style="{StaticResource Num}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,10,0,0"/>
                <local:SplitBar x:Name="LanBar" Grid.Row="1" Grid.Column="2" Height="5" VerticalAlignment="Center" Margin="0,10,0,0"/>
              </Grid>
              <WrapPanel Grid.Column="5" Orientation="Vertical" Margin="24,0,0,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="{DynamicResource Danger}" Margin="0,0,7,0"/><TextBlock Text="Security event" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="{DynamicResource Warning}" Margin="0,0,7,0"/><TextBlock Text="Warning" Style="{StaticResource Muted}"/></StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2"><Ellipse Width="8" Height="8" Fill="{DynamicResource Info}" Margin="0,0,7,0"/><TextBlock Text="Information" Style="{StaticResource Muted}"/></StackPanel>
              </WrapPanel>
            </Grid>
            <Grid x:Name="OverviewRow" Grid.Row="1" Margin="0,14,0,0">
              <Border CornerRadius="8" Background="{DynamicResource Surface2}" Height="52" ClipToBounds="True">
                <local:TrafficChart x:Name="OverviewChart" Compact="True" Brushable="True"
                                    AutomationProperties.Name="Whole period overview - click or drag to move the visible window"/>
              </Border>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Usage ============ -->
      <Grid x:Name="PageUsage" Tag="Usage" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PageHeader x:Name="UsageHeader" Title="Usage" Subtitle="">
          <StackPanel Orientation="Horizontal">
            <local:SearchBox x:Name="UsageSearch" Width="220" Placeholder="Search apps" Margin="0,0,10,0" AutomationProperties.Name="Search apps"/>
            <Border Style="{StaticResource SegBox}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="UsageViewBreakdown" Style="{StaticResource Seg}" GroupName="UsageView" Content="Breakdown" IsChecked="True" Checked="UsageView_Checked"/>
                <RadioButton x:Name="UsageViewTable" Style="{StaticResource Seg}" GroupName="UsageView" Content="Apps table" Checked="UsageView_Checked"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </local:PageHeader>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="Today" Tag="today" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="Yesterday" Tag="yesterday" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="7 days" Tag="d7" IsChecked="True" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="30 days" Tag="d30" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="This month" Tag="month" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="All time" Tag="all" Checked="AppsPeriod_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AppP" Content="Custom range" Tag="custom" Checked="AppsPeriod_Checked"/>
          <StackPanel x:Name="AppsCustom" Orientation="Horizontal" Visibility="Collapsed" Margin="4,0,0,6">
            <DatePicker x:Name="AppFrom" SelectedDateChanged="Date_Changed" AutomationProperties.Name="From date"/>
            <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource TextMuted}"/>
            <DatePicker x:Name="AppTo" SelectedDateChanged="Date_Changed" AutomationProperties.Name="To date"/>
          </StackPanel>
        </WrapPanel>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Panel}" Margin="0,0,14,0" Padding="20">
            <StackPanel>
              <Grid Width="150" Height="150" HorizontalAlignment="Center">
                <local:Donut x:Name="UsageDonut" Thickness="12"/>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                  <TextBlock Text="TOTAL" Style="{StaticResource Cap}" HorizontalAlignment="Center"/>
                  <local:MetricText x:Name="UsageTotal" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                </StackPanel>
              </Grid>
              <Grid Margin="0,22,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Incoming}" Margin="0,0,6,0"/>
                    <TextBlock Text="Incoming" Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <local:MetricText x:Name="UsageIn" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Outgoing}" Margin="0,0,6,0"/>
                    <TextBlock Text="Outgoing" Style="{StaticResource Muted}"/>
                  </StackPanel>
                  <local:MetricText x:Name="UsageOut" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
                </StackPanel>
              </Grid>
              <Border Style="{StaticResource Divider}" Margin="0,18"/>
              <Grid>
                <TextBlock Text="Internet (WAN)" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="UsageWan" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
              </Grid>
              <local:SplitBar x:Name="UsageWanBar" Height="4" Margin="0,6,0,12"/>
              <Grid>
                <TextBlock Text="Local network (LAN)" Style="{StaticResource Muted}"/>
                <TextBlock x:Name="UsageLan" Style="{StaticResource Num}" HorizontalAlignment="Right" FontWeight="SemiBold"/>
              </Grid>
              <local:SplitBar x:Name="UsageLanBar" Height="4" Margin="0,6,0,0"/>
              <TextBlock x:Name="UsageCounts" Style="{StaticResource Muted}" Margin="0,18,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- breakdown: apps | hosts | traffic types -->
          <Border x:Name="BreakdownPanel" Grid.Column="1" Style="{StaticResource Panel}" Padding="10,12">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <Border x:Name="FilterBar" Background="{DynamicResource PrimaryFill}" CornerRadius="8" Padding="12,6" Margin="6,0,6,10" Visibility="Collapsed">
                <Grid>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE71C;" Style="{StaticResource Glyph}" FontSize="12" Foreground="{DynamicResource Primary}" Margin="0,0,8,0"/>
                    <TextBlock x:Name="FilterText" Foreground="{DynamicResource Primary}" VerticalAlignment="Center"/>
                  </StackPanel>
                  <Button Content="Clear filter" Style="{StaticResource BtnGhost}" HorizontalAlignment="Right" Click="ClearUsageFilter_Click"/>
                </Grid>
              </Border>
              <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/><ColumnDefinition Width="1"/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="Apps" Style="{StaticResource H2}" Margin="14,0,0,8"/>
                <TextBlock Grid.Column="2" Text="Hosts" Style="{StaticResource H2}" Margin="14,0,0,8"/>
                <TextBlock Grid.Column="4" Text="Traffic type" Style="{StaticResource H2}" Margin="14,0,0,8"/>
                <Border Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource Border}"/>
                <Border Grid.Column="3" Grid.RowSpan="2" Background="{DynamicResource Border}"/>
                <ListBox x:Name="ColApps" Grid.Row="1" Style="{StaticResource PlainList}" Margin="6,0" ItemTemplate="{StaticResource UsageItemTpl}"
                         SelectionChanged="UsageCol_SelectionChanged" AutomationProperties.Name="Apps"/>
                <ListBox x:Name="ColHosts" Grid.Row="1" Grid.Column="2" Style="{StaticResource PlainList}" Margin="6,0" ItemTemplate="{StaticResource UsageItemTpl}"
                         SelectionChanged="UsageCol_SelectionChanged" AutomationProperties.Name="Hosts"/>
                <ListBox x:Name="ColTypes" Grid.Row="1" Grid.Column="4" Style="{StaticResource PlainList}" Margin="6,0" ItemTemplate="{StaticResource UsageItemTpl}"
                         SelectionChanged="UsageCol_SelectionChanged" AutomationProperties.Name="Traffic types"/>
                <local:EmptyState x:Name="UsageEmpty" Grid.Row="1" Grid.ColumnSpan="5" Glyph="&#xEB05;" Title="No usage in this period"
                                  Text="Pick a longer period, or come back after apps have used the network." Visibility="Collapsed"/>
              </Grid>
            </Grid>
          </Border>

          <Border x:Name="AppsTablePanel" Grid.Column="1" Style="{StaticResource Panel}" Padding="8,6" Visibility="Collapsed">
            <Grid>
              <DataGrid x:Name="AppsGrid" AutomationProperties.Name="Apps usage table">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding Tip}"/>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTemplateColumn Header="App" Width="2*" MinWidth="160" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                          <Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,10,0"/>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Incoming" Binding="{Binding Download}" SortMemberPath="DownBytes" Width="*" MinWidth="80"/>
                  <DataGridTextColumn Header="Outgoing" Binding="{Binding Upload}" SortMemberPath="UpBytes" Width="*" MinWidth="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding Total}" SortMemberPath="TotalBytes" Width="*" MinWidth="80"/>
                  <DataGridTemplateColumn Header="Share" Width="1.3*" MinWidth="100" SortMemberPath="Percent">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <Grid VerticalAlignment="Center">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                          <TextBlock Text="{Binding Share}" Style="{StaticResource Muted}"/>
                          <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Minimum="0" Maximum="100" Height="5" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Now" Binding="{Binding Speed}" Width="0.9*" MinWidth="70" SortMemberPath="Speed"/>
                  <DataGridTextColumn Header="Last seen" Binding="{Binding Last}" Width="1.4*" MinWidth="110" SortMemberPath="LastTs"/>
                </DataGrid.Columns>
              </DataGrid>
              <local:EmptyState x:Name="AppsEmpty" Glyph="&#xEB05;" Title="No apps match" Text="Try another period or search." Visibility="Collapsed"/>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- ============ Firewall ============ -->
      <Grid x:Name="PageFirewall" Tag="Firewall" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PageHeader x:Name="FwHeader" Title="Firewall" Subtitle="">
          <StackPanel Orientation="Horizontal">
            <local:SearchBox x:Name="FwSearch" Width="240" Placeholder="Search apps, files or publishers" Margin="0,0,8,0" AutomationProperties.Name="Search firewall apps"/>
            <Button Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE72C;" Click="FwRefresh_Click" ToolTip="Refresh" AutomationProperties.Name="Refresh"/>
          </StackPanel>
        </local:PageHeader>

        <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,0,0,12" Padding="18,14">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Border x:Name="FwStateIcon" Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SuccessFill}">
              <TextBlock x:Name="FwStateGlyph" Text="&#xEA18;" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource Success}" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
              <TextBlock x:Name="FwStateText" Style="{StaticResource H2}" Text="Checking Windows Firewall…"/>
              <TextBlock x:Name="FwStatus" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,2,0,0"
                         Text="Turn an app off to block all of its incoming and outgoing traffic. NetUse creates the Windows Firewall rules for you."/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <ContentControl x:Name="FwCountAllowed" Style="{StaticResource Badge}" Tag="ok" Margin="0,0,8,0"/>
              <ContentControl x:Name="FwCountBlocked" Style="{StaticResource Badge}" Tag="bad"/>
            </StackPanel>
          </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="8,4,8,8">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="6,8,6,6" TextElement.FontSize="12" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource TextMuted}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="104"/>
                <ColumnDefinition Width="104"/><ColumnDefinition Width="70"/><ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="36"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Access"/>
              <TextBlock Grid.Column="2" Text="App"/>
              <TextBlock Grid.Column="3" Text="Incoming"/>
              <TextBlock Grid.Column="4" Text="Outgoing"/>
              <TextBlock Grid.Column="5" Text="Hosts"/>
              <TextBlock Grid.Column="6" Text="Last activity"/>
              <TextBlock Grid.Column="7" Text="Status"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
              <StackPanel Margin="0,0,4,0">
                <TextBlock x:Name="FwBlockedHeader" Style="{StaticResource Cap}" Margin="8,10,0,4"/>
                <ItemsControl x:Name="FwBlockedList" ItemTemplate="{StaticResource FwRowTpl}" Focusable="False"/>
                <TextBlock x:Name="FwAllowedHeader" Style="{StaticResource Cap}" Margin="8,14,0,4"/>
                <ItemsControl x:Name="FwAllowedList" ItemTemplate="{StaticResource FwRowTpl}" Focusable="False"/>
                <local:EmptyState x:Name="FwEmpty" Glyph="&#xEA18;" Title="No apps found"
                                  Text="Apps appear here once they use the network." Visibility="Collapsed"/>
              </StackPanel>
            </ScrollViewer>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Network (connections, open ports, devices) ============ -->
      <Grid x:Name="PageNetwork" Tag="Network" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PageHeader x:Name="NetHeader" Title="Network" Subtitle="">
          <StackPanel Orientation="Horizontal">
            <local:SearchBox x:Name="NetSearch" Width="220" Placeholder="Filter" Margin="0,0,10,0" AutomationProperties.Name="Filter"/>
            <Border Style="{StaticResource SegBox}">
              <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NetModeConn" Style="{StaticResource Seg}" GroupName="NetMode" Content="Connections" IsChecked="True" Checked="NetMode_Checked"/>
                <RadioButton x:Name="NetModePorts" Style="{StaticResource Seg}" GroupName="NetMode" Content="Open ports" Checked="NetMode_Checked"/>
                <RadioButton x:Name="NetModeDevices" Style="{StaticResource Seg}" GroupName="NetMode" Content="Devices" Checked="NetMode_Checked"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </local:PageHeader>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,0,12">
          <Border Style="{StaticResource Panel}" Margin="0,0,7,0" Padding="16,12">
            <StackPanel>
              <TextBlock Text="THIS PC" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="NetPc" Style="{StaticResource H2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NetPcSub" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="7,0" Padding="16,12">
            <StackPanel>
              <TextBlock Text="ROUTER" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="NetGw" Style="{StaticResource H2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NetGwSub" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="7,0" Padding="16,12">
            <StackPanel>
              <TextBlock Text="WI-FI" Style="{StaticResource Cap}"/>
              <TextBlock x:Name="NetWifi" Style="{StaticResource H2}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="NetWifiSub" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Panel}" Margin="7,0,0,0" Padding="16,12">
            <Grid>
              <StackPanel>
                <TextBlock Text="DEVICES" Style="{StaticResource Cap}"/>
                <TextBlock x:Name="NetDevCount" Style="{StaticResource H2}" Margin="0,6,0,0"/>
                <TextBlock x:Name="NetDevSub" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <Button x:Name="ScanBtn" Content="Scan" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" VerticalAlignment="Top"
                      Padding="12,5" Click="Scan_Click" ToolTip="Look for devices on your local network"/>
            </Grid>
          </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="8,6">
          <Grid>
            <DataGrid x:Name="ConnGrid" AutomationProperties.Name="Connections">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="App" Width="1.5*" MinWidth="140" SortMemberPath="App">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Image Source="{Binding Icon}" Width="18" Height="18" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding App}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="64"/>
                <DataGridTextColumn x:Name="ColLocal" Header="Local" Binding="{Binding Local}" Width="1.3*"/>
                <DataGridTextColumn x:Name="ColRemote" Header="Remote" Binding="{Binding Remote}" Width="1.3*"/>
                <DataGridTextColumn x:Name="ColHost" Header="Host" Binding="{Binding Host}" Width="2*"/>
                <DataGridTextColumn Header="Service" Binding="{Binding Service}" Width="1.2*"/>
                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="0.9*"/>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="DevGrid" Visibility="Collapsed" AutomationProperties.Name="Devices on the local network">
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="Device" Width="2*" MinWidth="160" SortMemberPath="Name">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <Ellipse Style="{StaticResource Dot}" Tag="{Binding Kind2}" Margin="0,0,10,0" ToolTip="{Binding Note}"/>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="14" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="IP address" Binding="{Binding Ip}" Width="*"/>
                <DataGridTextColumn Header="MAC address" Binding="{Binding Mac}" Width="1.2*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*"/>
                <DataGridTextColumn Header="First seen" Binding="{Binding First}" Width="1.2*"/>
                <DataGridTextColumn Header="Last seen" Binding="{Binding Last}" Width="1.2*"/>
              </DataGrid.Columns>
            </DataGrid>
            <local:EmptyState x:Name="NetEmpty" Glyph="&#xE839;" Visibility="Collapsed"/>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ Alerts ============ -->
      <Grid x:Name="PageAlerts" Tag="Alerts" Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <local:PageHeader x:Name="AlertsHeader" Title="Alerts" Subtitle="">
          <StackPanel Orientation="Horizontal">
            <Button Content="Mark all as read" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" Click="MarkRead_Click"/>
            <Button Content="Clear all" Style="{StaticResource BtnDangerSubtle}" Click="ClearAlerts_Click"/>
          </StackPanel>
        </local:PageHeader>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
          <RadioButton Style="{StaticResource Chip}" GroupName="AlF" Content="All" Tag="all" IsChecked="True" Checked="AlertFilter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AlF" Content="Unread" Tag="unread" Checked="AlertFilter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AlF" Content="Security" Tag="bad" Checked="AlertFilter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AlF" Content="Warnings" Tag="warn" Checked="AlertFilter_Checked"/>
          <RadioButton Style="{StaticResource Chip}" GroupName="AlF" Content="Information" Tag="info" Checked="AlertFilter_Checked"/>
        </WrapPanel>
        <Border Grid.Row="2" Style="{StaticResource Panel}" Padding="8">
          <Grid>
            <ListBox x:Name="AlertsList" Style="{StaticResource PlainList}" AutomationProperties.Name="Alerts">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="8,10" Background="Transparent">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="16"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource Primary}" HorizontalAlignment="Left" VerticalAlignment="Center"
                             Visibility="{Binding Unread, Converter={StaticResource B2V}}" ToolTip="Unread"/>
                    <Grid Grid.Column="1" Width="26" Height="26" HorizontalAlignment="Left" VerticalAlignment="Center">
                      <Border CornerRadius="7" Background="{DynamicResource Surface2}" Visibility="{Binding Glyph, Converter={StaticResource NonEmpty}}">
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                      </Border>
                      <Image Source="{Binding Icon}" Width="24" Height="24"/>
                    </Grid>
                    <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="title" Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                        <ContentControl Style="{StaticResource Badge}" Tag="{Binding Kind}" Content="{Binding Type}" Margin="8,0,0,0"/>
                      </StackPanel>
                      <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="3" Text="{Binding Time}" ToolTip="{Binding FullTime}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel x:Name="actions" Grid.Column="4" Orientation="Horizontal" Opacity="0" HorizontalAlignment="Right">
                      <Button Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE73E;" Click="AlertRead_Click" ToolTip="Mark as read"
                              AutomationProperties.Name="Mark as read" Visibility="{Binding Unread, Converter={StaticResource B2V}}"/>
                      <Button Style="{StaticResource IconBtn}" local:Ui.Glyph="&#xE74D;" Click="AlertDelete_Click" ToolTip="Delete"
                              AutomationProperties.Name="Delete alert"/>
                    </StackPanel>
                  </Grid>
                  <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Unread}" Value="True"><Setter TargetName="title" Property="FontWeight" Value="SemiBold"/></DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="actions" Property="Opacity" Value="1"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                      <Setter TargetName="actions" Property="Opacity" Value="1"/>
                    </DataTrigger>
                  </DataTemplate.Triggers>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <local:EmptyState x:Name="AlertsEmpty" Glyph="&#xEA8F;" Title="No alerts" Visibility="Collapsed"
                              Text="NetUse alerts you about new apps, devices, Remote Desktop connections, Wi-Fi changes and traffic spikes."/>
          </Grid>
        </Border>
      </Grid>

      <!-- ============ System (hardware resources) ============ -->
      <ScrollViewer x:Name="PageSystem" Tag="System" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="0,0,6,0">
          <local:PageHeader x:Name="SysHeader" Title="System" Subtitle=""/>
          <UniformGrid Columns="2" Margin="0,0,0,14">
            <Border Style="{StaticResource Panel}" Margin="0,0,7,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/></Grid.RowDefinitions>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="PROCESSOR" Style="{StaticResource Cap}"/>
                    <local:MetricText x:Name="CpuText" Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="CpuSub" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                </Grid>
                <local:TrafficChart x:Name="CpuChart" Grid.Row="1" Compact="True" FixedMax="100" Margin="0,10,0,0"
                                    AutomationProperties.Name="Processor use, last two minutes"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource Panel}" Margin="7,0,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="90"/></Grid.RowDefinitions>
                <Grid>
                  <StackPanel>
                    <TextBlock Text="MEMORY" Style="{StaticResource Cap}"/>
                    <local:MetricText x:Name="MemText" Style="{StaticResource Metric}" Margin="0,6,0,0"/>
                  </StackPanel>
                  <TextBlock x:Name="MemSub" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                </Grid>
                <local:TrafficChart x:Name="MemChart" Grid.Row="1" Compact="True" FixedMax="100" Margin="0,10,0,0"
                                    AutomationProperties.Name="Memory use, last two minutes"/>
              </Grid>
            </Border>
          </UniformGrid>

          <Border Style="{StaticResource Panel}" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Drives" Style="{StaticResource H2}" Margin="0,0,0,10"/>
              <ItemsControl x:Name="DrivesList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,6">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xEDA2;" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Label}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <ProgressBar x:Name="bar" Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="2" Text="{Binding Text}" Style="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <DataTemplate.Triggers>
                      <DataTrigger Binding="{Binding Kind}" Value="warn"><Setter TargetName="bar" Property="Foreground" Value="{DynamicResource Warning}"/></DataTrigger>
                      <DataTrigger Binding="{Binding Kind}" Value="bad"><Setter TargetName="bar" Property="Foreground" Value="{DynamicResource Danger}"/></DataTrigger>
                    </DataTemplate.Triggers>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Panel}">
            <StackPanel>
              <TextBlock Text="Network adapters" Style="{StaticResource H2}" Margin="0,0,0,6"/>
              <ItemsControl x:Name="AdaptersList" Focusable="False">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,12">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="150"/><ColumnDefinition Width="170"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Surface2}" Margin="0,0,12,0">
                          <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="15" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Ip}" Style="{StaticResource Num}"/>
                          <TextBlock Text="{Binding Mac}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Now}" Style="{StaticResource Num}"/>
                          <TextBlock Text="{Binding Speed}" Style="{StaticResource Muted}"/>
                        </StackPanel>
                        <TextBlock Grid.Column="4" Text="{Binding Totals}" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <!-- ============ Settings ============ -->
      <ScrollViewer x:Name="PageSettings" Tag="Settings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel MaxWidth="780" HorizontalAlignment="Left" Margin="0,0,6,0">
          <local:PageHeader Title="Settings" Subtitle="Changes are saved automatically"/>

          <TextBlock Text="APPEARANCE" Style="{StaticResource Cap}" Margin="2,0,0,8"/>
          <Border Style="{StaticResource Panel}" Padding="20,0" Margin="0,0,0,18">
            <StackPanel Margin="0,-1,0,0">
              <local:SettingRow Title="Theme" Description="Colour scheme for the whole app.">
                <Border Style="{StaticResource SegBox}">
                  <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ThemeLight" Style="{StaticResource Seg}" GroupName="Theme" Content="Light" Tag="light" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeDark" Style="{StaticResource Seg}" GroupName="Theme" Content="Dark" Tag="dark" Checked="Theme_Checked"/>
                    <RadioButton x:Name="ThemeBlue" Style="{StaticResource Seg}" GroupName="Theme" Content="Dark Blue" Tag="darkblue" Checked="Theme_Checked"/>
                  </StackPanel>
                </Border>
              </local:SettingRow>
            </StackPanel>
          </Border>

          <TextBlock Text="GENERAL" Style="{StaticResource Cap}" Margin="2,0,0,8"/>
          <Border Style="{StaticResource Panel}" Padding="20,0" Margin="0,0,0,18">
            <StackPanel Margin="0,-1,0,0">
              <local:SettingRow Title="Start with Windows" Description="Starts minimized to the tray when you sign in. NetUse keeps a copy in Program Files for this.">
                <CheckBox x:Name="SwStartup" Style="{StaticResource Switch}" Click="SwStartup_Click" AutomationProperties.Name="Start with Windows"/>
              </local:SettingRow>
              <local:SettingRow Title="Keep running in the tray" Description="Closing the window keeps monitoring in the background.">
                <CheckBox x:Name="SwTray" Style="{StaticResource Switch}" Click="Switch_Click" Tag="minToTray" AutomationProperties.Name="Keep running in the tray"/>
              </local:SettingRow>
              <local:SettingRow Title="Mini graph" Description="Small always-on-top window with live speed.">
                <CheckBox x:Name="SwMini" Style="{StaticResource Switch}" Click="SwMini_Click" AutomationProperties.Name="Mini graph"/>
              </local:SettingRow>
              <local:SettingRow Title="Desktop notifications" Description="Turn off for discreet mode: alerts are still recorded, but no pop-ups.">
                <CheckBox x:Name="SwNotify" Style="{StaticResource Switch}" Click="Switch_Click" Tag="notify" AutomationProperties.Name="Desktop notifications"/>
              </local:SettingRow>
            </StackPanel>
          </Border>

          <TextBlock Text="ALERTS" Style="{StaticResource Cap}" Margin="2,0,0,8"/>
          <Border Style="{StaticResource Panel}" Padding="20,0" Margin="0,0,0,18">
            <StackPanel Margin="0,-1,0,0">
              <local:SettingRow Title="New app uses the network" Description="The first time an app connects.">
                <CheckBox x:Name="SwAlertNew" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertNew" AutomationProperties.Name="Alert on new apps"/>
              </local:SettingRow>
              <local:SettingRow Title="New device on your network" Description="A device you haven't seen before joins the local network.">
                <CheckBox x:Name="SwAlertDevice" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertDevice" AutomationProperties.Name="Alert on new devices"/>
              </local:SettingRow>
              <local:SettingRow Title="Remote Desktop connections" Description="Someone connects to this PC with Remote Desktop.">
                <CheckBox x:Name="SwAlertRdp" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertRdp" AutomationProperties.Name="Alert on Remote Desktop connections"/>
              </local:SettingRow>
              <local:SettingRow Title="Wi-Fi access point changes" Description="Detects a known network name served by a new or less secure access point (evil twin).">
                <CheckBox x:Name="SwAlertWifi" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertWifi" AutomationProperties.Name="Alert on Wi-Fi changes"/>
              </local:SettingRow>
              <local:SettingRow Title="Hosts file changes" Description="The Windows hosts file can silently redirect websites.">
                <CheckBox x:Name="SwAlertHosts" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertHosts" AutomationProperties.Name="Alert on hosts file changes"/>
              </local:SettingRow>
              <local:SettingRow Title="Traffic spikes" Description="An app uses more than the threshold below.">
                <CheckBox x:Name="SwAlertSpike" Style="{StaticResource Switch}" Click="Switch_Click" Tag="alertSpike" AutomationProperties.Name="Alert on traffic spikes"/>
              </local:SettingRow>
              <local:SettingRow Title="Spike threshold" Description="Per app, in MB/s (0.1 – 10000).">
                <TextBox x:Name="SpikeBox" Width="110" Tag="" LostKeyboardFocus="NumBox_LostFocus" KeyDown="NumBox_KeyDown" AutomationProperties.Name="Spike threshold in megabytes per second"/>
              </local:SettingRow>
            </StackPanel>
          </Border>

          <TextBlock Text="DATA PLAN" Style="{StaticResource Cap}" Margin="2,0,0,8"/>
          <Border Style="{StaticResource Panel}" Padding="20,0" Margin="0,0,0,18">
            <StackPanel Margin="0,-1,0,0">
              <local:SettingRow Title="Monthly data cap" Description="In GB. Shows a usage bar on Overview and alerts at 80% and 100%. 0 turns it off.">
                <TextBox x:Name="CapBox" Width="110" LostKeyboardFocus="NumBox_LostFocus" KeyDown="NumBox_KeyDown" AutomationProperties.Name="Monthly data cap in gigabytes"/>
              </local:SettingRow>
              <local:SettingRow Title="Billing day" Description="Day of the month your plan resets (1 – 28).">
                <TextBox x:Name="BillBox" Width="110" LostKeyboardFocus="NumBox_LostFocus" KeyDown="NumBox_KeyDown" AutomationProperties.Name="Billing day of month"/>
              </local:SettingRow>
            </StackPanel>
          </Border>

          <TextBlock Text="PRIVACY &amp; DATA" Style="{StaticResource Cap}" Margin="2,0,0,8"/>
          <Border Style="{StaticResource Panel}" Padding="20,0" Margin="0,0,0,10">
            <StackPanel Margin="0,-1,0,0">
              <local:SettingRow Title="Look up host names" Description="Shows names instead of IP addresses. Each lookup asks your DNS server about that address.">
                <CheckBox x:Name="SwResolve" Style="{StaticResource Switch}" Click="SwResolve_Click" AutomationProperties.Name="Look up host names"/>
              </local:SettingRow>
              <local:SettingRow Title="Keep history for" Description="Days (1 – 3650). Older usage, alerts and host names are deleted.">
                <TextBox x:Name="RetBox" Width="110" LostKeyboardFocus="NumBox_LostFocus" KeyDown="NumBox_KeyDown" AutomationProperties.Name="History days"/>
              </local:SettingRow>
              <local:SettingRow Title="Export usage" Description="Per-minute usage of every app as a CSV file.">
                <Button Content="Export CSV…" Style="{StaticResource BtnSecondary}" Click="Export_Click"/>
              </local:SettingRow>
              <local:SettingRow Title="Clear history" Description="Deletes all usage, apps, alerts, devices and Wi-Fi history. Firewall rules are kept.">
                <Button Content="Clear history…" Style="{StaticResource BtnDangerSubtle}" Click="ClearHistory_Click"/>
              </local:SettingRow>
            </StackPanel>
          </Border>
          <TextBlock x:Name="SettingsStatus" Margin="2,4,0,14" TextWrapping="Wrap"/>
          <TextBlock x:Name="AboutText" Style="{StaticResource Muted}" Margin="2,0,0,20" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</Window>
